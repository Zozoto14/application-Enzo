__d(function(g,r,i,a,m,e,d){Object.defineProperty(e,"__esModule",{value:!0}),e.EXPLICATIONS=void 0,e.explication=function(s){return t[s]};var t=e.EXPLICATIONS={valeurTotale:{titre:'Valeur totale',court:'Ce que vaut votre portefeuille aujourd\u2019hui, liquidit\xe9s comprises.',detail:'Somme de la valeur de march\xe9 de chaque ligne, plus les esp\xe8ces disponibles sur vos comptes. C\u2019est le montant que vous obtiendriez, avant imp\xf4ts et frais, en vendant tout aujourd\u2019hui.'},plusValueLatente:{titre:'Plus-value latente',court:'Le gain que vous avez sur le papier, tant que vous n\u2019avez pas vendu.',detail:'Diff\xe9rence entre la valeur de march\xe9 actuelle et le prix de revient. Elle bouge chaque jour avec les cours, et ne devient un gain r\xe9el qu\u2019au moment de la vente.',piege:'Une plus-value latente n\u2019est jamais impos\xe9e. Seule une vente d\xe9clenche l\u2019imp\xf4t sur un compte-titres \u2014 et sur un PEA, m\xeame une vente ne le d\xe9clenche pas.'},plusValueRealisee:{titre:'Plus-value r\xe9alis\xe9e',court:'Le gain effectivement encaiss\xe9 sur les titres d\xe9j\xe0 vendus.',detail:'Produit de la vente, frais d\xe9duits, moins le prix de revient des titres c\xe9d\xe9s. C\u2019est cette somme qui entre dans le calcul de l\u2019imp\xf4t sur un compte-titres.'},pru:{titre:'PRU \u2014 prix de revient unitaire',court:'Ce que vous a co\xfbt\xe9, en moyenne, chaque titre que vous d\xe9tenez.',detail:'Total d\xe9pens\xe9, frais de courtage compris, divis\xe9 par le nombre de titres. Il sert de r\xe9f\xe9rence pour calculer la plus-value. En France, la r\xe8gle fiscale impose la moyenne pond\xe9r\xe9e : chaque nouvel achat le recalcule sur l\u2019ensemble de la ligne.',piege:'Certains outils proposent un PRU en FIFO, o\xf9 l\u2019on vend les titres les plus anciens d\u2019abord. C\u2019est une autre convention, et elle ne correspond pas \xe0 la r\xe8gle fiscale fran\xe7aise.'},totalReturn:{titre:'Performance totale',court:'Ce que votre portefeuille a gagn\xe9 ou perdu depuis le d\xe9but.',detail:'Compare la valeur actuelle \xe0 la somme r\xe9ellement investie. Simple \xe0 lire, mais ne dit pas si le r\xe9sultat vient de vos choix ou du moment o\xf9 vous avez investi.'},twr:{titre:'TWR \u2014 rendement pond\xe9r\xe9 par le temps',court:'La performance de vos choix, ind\xe9pendamment de vos versements.',detail:'Neutralise l\u2019effet des versements et des retraits en cha\xeenant les rendements de chaque sous-p\xe9riode. C\u2019est la mesure qui permet de se comparer honn\xeatement \xe0 un indice : verser 10 000 \u20ac ne fait pas \xab monter \xbb votre performance.',piege:'Un TWR calcul\xe9 depuis une valorisation quasi nulle explose en milliers de pour cent. Quand c\u2019est le cas, cette application refuse d\u2019afficher le chiffre plut\xf4t que d\u2019en montrer un qui n\u2019informe sur rien.'},tri:{titre:'TRI \u2014 taux de rentabilit\xe9 interne',court:'Le rendement r\xe9el de l\u2019argent que vous avez effectivement investi.',detail:'Tient compte du montant et de la date de chaque versement. Deux portefeuilles aux m\xeames titres peuvent avoir des TRI tr\xe8s diff\xe9rents si l\u2019un a investi avant une hausse et l\u2019autre apr\xe8s. C\u2019est la mesure la plus proche de votre exp\xe9rience r\xe9elle.',piege:'Le TRI est annualis\xe9 par construction. Sur quelques semaines, il produit des chiffres absurdes \u2014 d\u2019o\xf9 son indisponibilit\xe9 avant trois mois d\u2019historique.'},cagr:{titre:'Rendement annualis\xe9',court:'La performance ramen\xe9e \xe0 un rythme annuel, pour comparer des dur\xe9es.',detail:'R\xe9pond \xe0 : \xab si ce portefeuille avait progress\xe9 au m\xeame rythme r\xe9gulier, quel serait son rendement par an ? \xbb Utile pour comparer deux placements de dur\xe9es diff\xe9rentes.',piege:'Annualiser une p\xe9riode courte amplifie tout. Trois semaines de hausse donnent des rendements annuels \xe0 plusieurs chiffres, sans aucune valeur pr\xe9dictive.'},drawdown:{titre:'Drawdown \u2014 perte maximale',court:'La pire chute subie depuis un sommet, avant de remonter.',detail:'Mesure ce que vous auriez perdu au plus mauvais moment. Plus parlant que la volatilit\xe9 pour se demander : \xab aurais-je tenu sans vendre ? \xbb'},volatilite:{titre:'Volatilit\xe9',court:'L\u2019ampleur des variations de votre portefeuille.',detail:'\xc9cart-type des rendements, ramen\xe9 \xe0 une base annuelle. Une volatilit\xe9 de 15 % signifie que, la plupart du temps, le portefeuille varie de plus ou moins 15 % sur un an.',piege:'La volatilit\xe9 traite les hausses et les baisses de la m\xeame fa\xe7on. Un portefeuille qui ne fait que monter fortement para\xeetra \xab risqu\xe9 \xbb.'},sharpe:{titre:'Ratio de Sharpe',court:'Le rendement obtenu par unit\xe9 de risque pris.',detail:'Divise le rendement exc\xe9dentaire par la volatilit\xe9. Au-dessus de 1, le rendement r\xe9mun\xe8re correctement le risque. En dessous de 0,5, le portefeuille secoue beaucoup pour ce qu\u2019il rapporte.'},correlation:{titre:'Corr\xe9lation',court:'\xc0 quel point vos lignes montent et descendent ensemble.',detail:'Va de -1 \xe0 1. Proche de 1, vos titres bougent de concert et la diversification est illusoire. Proche de 0, ils sont ind\xe9pendants et se compensent.',piege:'D\xe9tenir dix lignes ne diversifie rien si elles sont toutes corr\xe9l\xe9es \xe0 0,9. Le nombre de lignes compte moins que leur ind\xe9pendance.'},rendementDividende:{titre:'Rendement sur dividende',court:'Ce que les dividendes rapportent, rapport\xe9 \xe0 ce que vous avez investi.',detail:'Dividendes annuels divis\xe9s par le prix de revient. Calcul\xe9 sur votre PRU plut\xf4t que sur le cours du jour, il dit ce que la ligne vous rapporte r\xe9ellement.'},plafondPEA:{titre:'Plafond de versement du PEA',court:'150 000 \u20ac de versements au maximum sur la dur\xe9e de vie du plan.',detail:'Seuls les versements comptent, pas la valeur du portefeuille : un PEA peut valoir 200 000 \u20ac sans d\xe9passer le plafond. Un retrait ne lib\xe8re pas de capacit\xe9 de versement.'},anterioritePEA:{titre:'Ant\xe9riorit\xe9 du PEA',court:'Apr\xe8s cinq ans, les gains \xe9chappent \xe0 l\u2019imp\xf4t sur le revenu.',detail:'Le compteur part de la date du premier versement. Pass\xe9 cinq ans, un retrait n\u2019est plus soumis \xe0 l\u2019imp\xf4t sur le revenu, et ne ferme plus le plan.',piege:'L\u2019exon\xe9ration ne porte que sur l\u2019imp\xf4t sur le revenu. Les pr\xe9l\xe8vements sociaux de 17,2 % restent dus, m\xeame apr\xe8s vingt ans.'},impotPEA:{titre:'Imposition du PEA',court:'Vendre dans un PEA ne d\xe9clenche aucun imp\xf4t. Seul un retrait le fait.',detail:'Vous pouvez arbitrer librement \xe0 l\u2019int\xe9rieur du plan sans cons\xe9quence fiscale. \xc0 la sortie, l\u2019imp\xf4t ne porte pas sur la plus-value du titre vendu mais sur une quote-part du gain du plan entier, proportionnelle au montant retir\xe9.',piege:'C\u2019est la diff\xe9rence la plus co\xfbteuse \xe0 ignorer : sur un compte-titres, chaque vente est imposable ; sur un PEA, aucune ne l\u2019est.'},pfu:{titre:'PFU \u2014 pr\xe9l\xe8vement forfaitaire unique',court:'30 % sur les gains d\u2019un compte-titres : 12,8 % d\u2019imp\xf4t et 17,2 % de pr\xe9l\xe8vements sociaux.',detail:'Appliqu\xe9 par d\xe9faut. L\u2019option pour le bar\xe8me progressif peut \xeatre plus avantageuse si votre taux marginal d\u2019imposition est faible, mais elle vaut alors pour tous vos revenus de capitaux de l\u2019ann\xe9e.'},moinsValueReportable:{titre:'Moins-value reportable',court:'Une perte r\xe9alis\xe9e vient r\xe9duire vos gains imposables.',detail:'Elle s\u2019impute sur les plus-values de m\xeame nature de la m\xeame ann\xe9e, puis se reporte sur les dix ann\xe9es suivantes. Vendre une ligne en perte avant le 31 d\xe9cembre peut donc r\xe9duire l\u2019imp\xf4t d\xfb sur vos gains de l\u2019ann\xe9e.'},fluxExterne:{titre:'Flux',court:'L\u2019argent qui entre et sort de vos comptes.',detail:'Versements et retraits, distingu\xe9s de la performance. Un portefeuille qui grossit parce que vous versez chaque mois n\u2019est pas un portefeuille qui performe.'},dca:{titre:'Versement moyen',court:'Ce que vous versez, en moyenne, chaque mois.',detail:'Investir une somme r\xe9guli\xe8re lisse le prix d\u2019achat : on ach\xe8te m\xe9caniquement plus de parts quand les cours baissent. C\u2019est ce qu\u2019on appelle le DCA.'},fraisCumules:{titre:'Frais cumul\xe9s',court:'Tout ce que les frais vous ont co\xfbt\xe9 depuis le d\xe9but.',detail:'Commissions de courtage et taxes sur les transactions. Rapport\xe9s au capital investi, ils donnent la performance que vous devez r\xe9aliser rien que pour les compenser.'},coursInconnu:{titre:'Cours inconnu',court:'Ces lignes sont exclues des totaux, faute de cours connu.',detail:'Plut\xf4t que de les valoriser \xe0 z\xe9ro, ce qui fausserait discr\xe8tement votre patrimoine, elles sont \xe9cart\xe9es et signal\xe9es. Rafra\xeechissez les cours ou saisissez-en un \xe0 la main.'}}},645);
