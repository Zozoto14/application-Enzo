{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "types": [
      "react",
      "react-dom",
      "node"
    ],
    "jsx": "react-jsx",
    "noEmit": true,
    "moduleSuffixes": [
      ".web",
      ""
    ]
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "../src/**/*.web.tsx",
    "../src/**/*.web.ts"
  ],
  "exclude": [
    "../node_modules"
  ]
}
