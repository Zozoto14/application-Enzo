    "publier-maj": "node scripts/publier-maj.mjs",
    "preparer-mac": "node scripts/preparer-mac.mjs",
    "verifier": "npx tsc --noEmit && npx tsc --noEmit -p bureau/tsconfig.json && npx jest --silent && npx eslint src App.tsx --ext .ts,.tsx",
    "bureau": "vite",
    "bureau:build": "vite build",
    "bureau:app": "cross-env-shell APPLIBOURSE_DEV=http://localhost:5177 electron .",
    "bureau:exe": "node scripts/version-build.mjs && npm run bureau:build && electron-builder --win",
    "icone": "node scripts/icone.mjs",
    "maj-pc": "node scripts/maj-pc.mjs",
    "apk": "node scripts/apk.mjs",
    "relais:deployer": "node scripts/deployer-relais.mjs",
    "relais:site": "node scripts/deployer-relais.mjs --site",
    "relais:tester": "node --test relais/*.test.mjs",
    "esport:tester": "node --test esport/test/*.test.mjs",
    "esport:tester:pg": "node esport/test/pg/lancer.mjs",
    "esport:local": "node esport/outils/serveur-local.mjs --graines",
    "esport:transfert": "node esport/outils/transfert.mjs",
    "office:hooks": "node scripts/office-hooks.mjs"
  },
