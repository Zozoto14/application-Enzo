  "engines": {
    "node": ">= 22.11.0"
  },
  "op-sqlite": {
    "sqlcipher": true
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "electron@40.10.6": true
  },
  "main": "bureau/electron/lanceur.mjs",
  "build": {
    "appId": "fr.applibourse.bureau",
    "productName": "AppDashboard",
    "directories": {
      "output": "C:/Users/zozot/AppData/Local/AppliBourse-paquet"
    },
    "files": [
      "bureau/dist/**/*",
      "bureau/electron/**/*",
      "bureau/icone/**/*",
      "package.json",
      "!node_modules/**/*"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "bureau/icone/icone-256.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "AppDashboard"
    }
  },
  "description": "Suivi de portefeuille personnel, chiffre et hors ligne",
  "author": "Zozoto"
