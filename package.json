    "jest": "^29.6.3",
    "prettier": "2.8.8",
    "react-dom": "^19.2.3",
    "react-native-web": "^0.21.2",
    "react-test-renderer": "19.2.3",
    "typescript": "^6.0.3",
    "vite": "^7.3.6"
